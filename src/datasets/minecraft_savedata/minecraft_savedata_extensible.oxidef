extensible union GameType {
  Survival,
  Creative,
  Adventure,
  Spectator,
  -----
}

extensible struct Item {
  count: i8,
  slot: u8,
  id: string<256>,
  -----
}

extensible struct Abilities {
  walk_speed: f32,
  fly_speed: f32,
  may_fly: bool,
  flying: bool,
  invulnerable: bool,
  may_build: bool,
  instabuild: bool,
  -----
}

extensible struct Vector3d {
  x: f64,
  y: f64,
  z: f64,
  -----
}

extensible struct Vector2f {
  x: f32,
  y: f32,
  -----
}

extensible struct Uuid {
  x0: u32,
  x1: u32,
  x2: u32,
  x3: u32,
  -----
}

extensible struct Entity {
  id: string<256>,
  pos: Vector3d,
  motion: Vector3d,
  rotation: Vector2f,
  fall_distance: f32,
  fire: u16,
  air: u16,
  on_ground: bool,
  no_gravity: bool,
  invulnerable: bool,
  portal_cooldown: i32,
  uuid: Uuid,
  custom_name: option<string<256>>,
  custom_name_visible: bool,
  silent: bool,
  glowing: bool,
  -----
}

extensible struct RecipeBook {
  recipes: list<1024, string<256>>,
  to_be_displayed: list<1024, string<256>>,
  is_filtering_craftable: bool,
  is_gui_open: bool,
  is_furnace_filtering_craftable: bool,
  is_furnace_gui_open: bool,
  is_blasting_furnace_filtering_craftable: bool,
  is_blasting_furnace_gui_open: bool,
  is_smoker_filtering_craftable: bool,
  is_smoker_gui_open: bool,
  -----
}

extensible struct Vehicle {
  uuid: Uuid,
  entity: Entity,
  -----
}

extensible struct Player {
  game_type: GameType,
  previous_game_type: GameType,
  score: i64,
  dimension: string<256>,
  selected_item_slot: u32,
  selected_item: Item,
  spawn_dimension: option<string<256>>,
  spawn_x: i64,
  spawn_y: i64,
  spawn_z: i64,
  spawn_forced: option<bool>,
  sleep_timer: u16,
  food_exhaustion_level: f32,
  food_saturation_level: f32,
  food_tick_timer: u32,
  xp_level: u32,
  xp_p: f32,
  xp_total: i32,
  xp_seed: i32,
  inventory: list<1024, Item>,
  ender_items: list<1024, Item>,
  abilities: Abilities,
  entered_nether_position: option<Vector3d>,
  root_vehicle: option<Vehicle>,
  shoulder_entity_left: option<Entity>,
  shoulder_entity_right: option<Entity>,
  seen_credits: bool,
  recipe_book: RecipeBook,
  -----
}

extensible struct Players {
  players: list<1048576, Player>,
  -----
}
